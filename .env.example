# Copy to .env before `docker compose up`. Every value below has a working
# default in compose.yaml, so an empty .env still boots.
#
#   cp .env.example .env

# ---------- ports on your machine ----------
WEB_PORT=8080
API_PORT=3000
DB_PORT=5433

# ---------- database ----------
POSTGRES_USER=mathkids
POSTGRES_PASSWORD=mathkids
POSTGRES_DB=mathkids

# ---------- api ----------
# Change this for anything other than local use.
JWT_SECRET=dev-only-secret-please-change
CORS_ORIGIN=http://localhost:8080
VITE_API_URL=http://localhost:3000
# Creates the demo parent and two children with real practice history.
SEED_ON_BOOT=true

# ---------- AI Math Tutor (optional) ----------
# The tutor runs against Ollama on YOUR machine. No API key exists anywhere in
# this project and no request leaves the host.
#
# Set TUTOR_ENABLED=false — or simply don't install Ollama — and the product
# still works end to end using static age-appropriate hints. Check status at
# GET /health/llm.
TUTOR_ENABLED=true

# On Windows and macOS, host.docker.internal resolves from inside the container.
# On Linux, compose.yaml maps it via host-gateway, and Ollama must listen on
# 0.0.0.0 — run it with OLLAMA_HOST=0.0.0.0 ollama serve
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Choose by what your hardware can actually do, and measure rather than guess:
#
#   cd api && npm run build && npm run tutor:check
#
# Measured on a CPU-only machine (no GPU offload), median per hint:
#   qwen2.5-coder:7b   4.7 GB   ~11.7 s   <- default. Stiffer prose, but it
#                                            obeys the schema and it finishes.
#   phi4:14b           9.1 GB   ~22.7 s   Better maths prose. Needs a GPU to
#                                            be worth it.
#   mistral-small:22b   12 GB   slower still — warmest language of the three.
#
# With GPU offload all of these drop to roughly 1-3 s and phi4:14b becomes the
# better default.
#
# Do NOT use a ":cloud" tagged model — those route to ollama.com and
# reintroduce the external dependency this design exists to avoid. The API
# refuses to start with one.
OLLAMA_MODEL=qwen2.5-coder:7b

# Deliberately generous. The hint is off the critical path: the child already
# has a static hint on screen, so a long budget here costs them nothing and
# lets a slow machine still produce a real explanation.
OLLAMA_TIMEOUT_MS=20000
# Without keep_alive the first hint after 5 idle minutes pays a full model
# load — 20 s or more for 9 GB, which reads as a hang during a demo.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_PREDICT=160
TUTOR_CACHE_TTL_HOURS=24
