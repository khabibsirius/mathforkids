# Frontend configuration.
#
# Vite inlines these at BUILD time, not at runtime — which is why compose.yaml
# passes VITE_API_URL to the web image as a build arg rather than as an
# environment variable on the container.
#
#   cp .env.example .env

# Where the API lives, as seen from the BROWSER (not from inside a container).
VITE_API_URL=http://localhost:3000
