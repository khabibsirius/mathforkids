# For running the API directly with `npm run dev`, outside Docker.
# For `docker compose up`, use the .env.example in the repository root instead.
#
#   cp .env.example .env

DATABASE_URL=postgresql://mathkids:mathkids@localhost:5433/mathkids
NODE_ENV=development
PORT=3000

# Any string of 16+ characters. Must not contain "dev-only" in production.
JWT_SECRET=local-development-secret-not-for-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_CHILD_TTL=12h

CORS_ORIGIN=http://localhost:5173,http://localhost:8080
SEED_ON_BOOT=true

# --- AI Math Tutor (optional) ---
# Set false, or leave Ollama uninstalled, and the product still works end to
# end with static hints. Status: GET /health/llm
TUTOR_ENABLED=true
# Running outside Docker, talk to Ollama on localhost directly.
OLLAMA_BASE_URL=http://localhost:11434
# A ":cloud" tagged model is refused at boot — it would send data off-machine.
#
# Pick by what your hardware can do. Measure it: npm run tutor:check
# Measured here on a CPU-only machine (no GPU offload):
#   qwen2.5-coder:7b   ~11.7 s median   <- default: the only local model that
#                                          answers in a tolerable window here
#   phi4:14b           ~22.7 s median      better prose, too slow without a GPU
# On a GPU both drop to 1-3 s and phi4:14b is the better choice.
OLLAMA_MODEL=qwen2.5-coder:7b

# Generous on purpose. The hint is OFF the critical path — the child already
# has a static hint on screen — so a long server-side budget costs them
# nothing and simply lets a slow machine still produce a real explanation.
OLLAMA_TIMEOUT_MS=20000
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_PREDICT=160
TUTOR_CACHE_TTL_HOURS=24
