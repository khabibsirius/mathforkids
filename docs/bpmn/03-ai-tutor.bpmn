<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_AiTutor"
                  targetNamespace="https://github.com/khabibsirius/mathforkids/bpmn"
                  exporter="hand-authored" exporterVersion="1.0">

  <!--
    Process 3 of 3 — AI Math Tutor. Called asynchronously by
    02-practice-session.bpmn (CallActivity_Tutor -> Process_AiTutor).

    Every path reaches End_Delivered with a usable hint. The model is never
    trusted: constrained decoding fixes the SHAPE, the safety gate checks the
    MEANING, and any failure falls through to a static template. The child
    cannot tell which path ran.
  -->

  <bpmn:collaboration id="Collaboration_AiTutor">
    <bpmn:participant id="Participant_Tutor" name="AI Math Tutor (inside the API)" processRef="Process_AiTutor" />
    <bpmn:participant id="Participant_Ollama" name="Ollama — local LLM on the host (no API key, no internet)" />
    <bpmn:messageFlow id="Msg_Request" name="POST /api/chat" sourceRef="Task_CallOllama" targetRef="Participant_Ollama" />
    <bpmn:messageFlow id="Msg_Response" name="JSON hint" sourceRef="Participant_Ollama" targetRef="Task_Parse" />
  </bpmn:collaboration>

  <bpmn:process id="Process_AiTutor" name="Generate and verify an age-appropriate hint" isExecutable="false">

    <bpmn:startEvent id="Start_Wrong" name="Wrong answer recorded">
      <bpmn:outgoing>T_01</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_BuildPrompt" name="Build prompt: age, topic, the two numbers, the child's answer">
      <bpmn:incoming>T_01</bpmn:incoming>
      <bpmn:outgoing>T_02</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_CacheLookup" name="Look up hint cache (topic, operands, age band)">
      <bpmn:incoming>T_02</bpmn:incoming>
      <bpmn:outgoing>T_03</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Cached" name="Cached?">
      <bpmn:incoming>T_03</bpmn:incoming>
      <bpmn:outgoing>T_Hit</bpmn:outgoing>
      <bpmn:outgoing>T_Miss</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_CallOllama" name="Call Ollama: JSON schema, low temperature, bounded timeout">
      <bpmn:incoming>T_Miss</bpmn:incoming>
      <bpmn:outgoing>T_04</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:boundaryEvent id="Boundary_Timeout" name="timeout" attachedToRef="Task_CallOllama" cancelActivity="true">
      <bpmn:outgoing>T_Timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_01" />
    </bpmn:boundaryEvent>

    <bpmn:boundaryEvent id="Boundary_Error" name="unreachable" attachedToRef="Task_CallOllama" cancelActivity="true">
      <bpmn:outgoing>T_Error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_01" />
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="Task_Parse" name="Parse reply, strip any &lt;think&gt; block">
      <bpmn:incoming>T_04</bpmn:incoming>
      <bpmn:outgoing>T_05</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Schema" name="Shape valid?">
      <bpmn:incoming>T_05</bpmn:incoming>
      <bpmn:outgoing>T_SchemaOk</bpmn:outgoing>
      <bpmn:outgoing>T_SchemaBad</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_SafetyGate" name="Safety gate: answer not leaked, ≤2 sentences, age vocabulary, no links">
      <bpmn:incoming>T_SchemaOk</bpmn:incoming>
      <bpmn:outgoing>T_06</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="Gateway_Safe" name="Passes every check?">
      <bpmn:incoming>T_06</bpmn:incoming>
      <bpmn:outgoing>T_SafeOk</bpmn:outgoing>
      <bpmn:outgoing>T_SafeBad</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_Fallback" name="Use static age-appropriate hint template">
      <bpmn:incoming>T_Timeout</bpmn:incoming>
      <bpmn:incoming>T_Error</bpmn:incoming>
      <bpmn:incoming>T_SchemaBad</bpmn:incoming>
      <bpmn:incoming>T_SafeBad</bpmn:incoming>
      <bpmn:outgoing>T_FallbackOut</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Cache" name="Store hint in cache (24h)">
      <bpmn:incoming>T_SafeOk</bpmn:incoming>
      <bpmn:outgoing>T_07</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_Return" name="Deliver hint to the session">
      <bpmn:incoming>T_07</bpmn:incoming>
      <bpmn:incoming>T_Hit</bpmn:incoming>
      <bpmn:incoming>T_FallbackOut</bpmn:incoming>
      <bpmn:outgoing>T_08</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="End_Delivered" name="Hint delivered">
      <bpmn:incoming>T_08</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="T_01" sourceRef="Start_Wrong" targetRef="Task_BuildPrompt" />
    <bpmn:sequenceFlow id="T_02" sourceRef="Task_BuildPrompt" targetRef="Task_CacheLookup" />
    <bpmn:sequenceFlow id="T_03" sourceRef="Task_CacheLookup" targetRef="Gateway_Cached" />
    <bpmn:sequenceFlow id="T_Hit" name="hit — 0ms, no model call" sourceRef="Gateway_Cached" targetRef="Task_Return" />
    <bpmn:sequenceFlow id="T_Miss" name="miss" sourceRef="Gateway_Cached" targetRef="Task_CallOllama" />
    <bpmn:sequenceFlow id="T_04" sourceRef="Task_CallOllama" targetRef="Task_Parse" />
    <bpmn:sequenceFlow id="T_Timeout" sourceRef="Boundary_Timeout" targetRef="Task_Fallback" />
    <bpmn:sequenceFlow id="T_Error" sourceRef="Boundary_Error" targetRef="Task_Fallback" />
    <bpmn:sequenceFlow id="T_05" sourceRef="Task_Parse" targetRef="Gateway_Schema" />
    <bpmn:sequenceFlow id="T_SchemaOk" name="yes" sourceRef="Gateway_Schema" targetRef="Task_SafetyGate" />
    <bpmn:sequenceFlow id="T_SchemaBad" name="no" sourceRef="Gateway_Schema" targetRef="Task_Fallback" />
    <bpmn:sequenceFlow id="T_06" sourceRef="Task_SafetyGate" targetRef="Gateway_Safe" />
    <bpmn:sequenceFlow id="T_SafeOk" name="yes" sourceRef="Gateway_Safe" targetRef="Task_Cache" />
    <bpmn:sequenceFlow id="T_SafeBad" name="no — discard model output" sourceRef="Gateway_Safe" targetRef="Task_Fallback" />
    <bpmn:sequenceFlow id="T_07" sourceRef="Task_Cache" targetRef="Task_Return" />
    <bpmn:sequenceFlow id="T_FallbackOut" name="never cached" sourceRef="Task_Fallback" targetRef="Task_Return" />
    <bpmn:sequenceFlow id="T_08" sourceRef="Task_Return" targetRef="End_Delivered" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_AiTutor">
    <bpmndi:BPMNPlane id="Plane_AiTutor" bpmnElement="Collaboration_AiTutor">

      <bpmndi:BPMNShape id="Shape_Participant_Tutor" bpmnElement="Participant_Tutor" isHorizontal="true">
        <dc:Bounds x="160" y="60" width="2140" height="340" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_Ollama" bpmnElement="Participant_Ollama" isHorizontal="true">
        <dc:Bounds x="160" y="460" width="2140" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Start_Wrong" bpmnElement="Start_Wrong">
        <dc:Bounds x="240" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="221" y="205" width="75" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_BuildPrompt" bpmnElement="Task_BuildPrompt">
        <dc:Bounds x="420" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CacheLookup" bpmnElement="Task_CacheLookup">
        <dc:Bounds x="600" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Cached" bpmnElement="Gateway_Cached" isMarkerVisible="true">
        <dc:Bounds x="780" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="781" y="212" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_CallOllama" bpmnElement="Task_CallOllama">
        <dc:Bounds x="960" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_Timeout" bpmnElement="Boundary_Timeout">
        <dc:Bounds x="962" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="908" y="242" width="48" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Boundary_Error" bpmnElement="Boundary_Error">
        <dc:Bounds x="1022" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1062" y="242" width="64" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Parse" bpmnElement="Task_Parse">
        <dc:Bounds x="1140" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Schema" bpmnElement="Gateway_Schema" isMarkerVisible="true">
        <dc:Bounds x="1320" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1312" y="118" width="66" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_SafetyGate" bpmnElement="Task_SafetyGate">
        <dc:Bounds x="1500" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Safe" bpmnElement="Gateway_Safe" isMarkerVisible="true">
        <dc:Bounds x="1680" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1661" y="118" width="89" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Fallback" bpmnElement="Task_Fallback">
        <dc:Bounds x="1500" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Cache" bpmnElement="Task_Cache">
        <dc:Bounds x="1860" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_Return" bpmnElement="Task_Return">
        <dc:Bounds x="2040" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Delivered" bpmnElement="End_Delivered">
        <dc:Bounds x="2220" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="2207" y="205" width="63" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_T_01" bpmnElement="T_01">
        <di:waypoint x="276" y="180" /><di:waypoint x="420" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_02" bpmnElement="T_02">
        <di:waypoint x="520" y="180" /><di:waypoint x="600" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_03" bpmnElement="T_03">
        <di:waypoint x="700" y="180" /><di:waypoint x="780" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_Miss" bpmnElement="T_Miss">
        <di:waypoint x="830" y="180" /><di:waypoint x="960" y="180" />
        <bpmndi:BPMNLabel><dc:Bounds x="879" y="162" width="23" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_Hit" bpmnElement="T_Hit">
        <di:waypoint x="805" y="155" /><di:waypoint x="805" y="100" /><di:waypoint x="2090" y="100" /><di:waypoint x="2090" y="140" />
        <bpmndi:BPMNLabel><dc:Bounds x="1367" y="76" width="126" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_04" bpmnElement="T_04">
        <di:waypoint x="1060" y="180" /><di:waypoint x="1140" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_Timeout" bpmnElement="T_Timeout">
        <di:waypoint x="980" y="238" /><di:waypoint x="980" y="340" /><di:waypoint x="1500" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_Error" bpmnElement="T_Error">
        <di:waypoint x="1040" y="238" /><di:waypoint x="1040" y="310" /><di:waypoint x="1500" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_05" bpmnElement="T_05">
        <di:waypoint x="1240" y="180" /><di:waypoint x="1320" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_SchemaOk" bpmnElement="T_SchemaOk">
        <di:waypoint x="1370" y="180" /><di:waypoint x="1500" y="180" />
        <bpmndi:BPMNLabel><dc:Bounds x="1424" y="162" width="19" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_SchemaBad" bpmnElement="T_SchemaBad">
        <di:waypoint x="1345" y="205" /><di:waypoint x="1345" y="250" /><di:waypoint x="1550" y="250" /><di:waypoint x="1550" y="280" />
        <bpmndi:BPMNLabel><dc:Bounds x="1353" y="222" width="15" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_06" bpmnElement="T_06">
        <di:waypoint x="1600" y="180" /><di:waypoint x="1680" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_SafeOk" bpmnElement="T_SafeOk">
        <di:waypoint x="1730" y="180" /><di:waypoint x="1860" y="180" />
        <bpmndi:BPMNLabel><dc:Bounds x="1779" y="162" width="19" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_SafeBad" bpmnElement="T_SafeBad">
        <di:waypoint x="1705" y="205" /><di:waypoint x="1705" y="320" /><di:waypoint x="1600" y="320" />
        <bpmndi:BPMNLabel><dc:Bounds x="1613" y="276" width="140" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_07" bpmnElement="T_07">
        <di:waypoint x="1960" y="180" /><di:waypoint x="2040" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_FallbackOut" bpmnElement="T_FallbackOut">
        <di:waypoint x="1550" y="360" /><di:waypoint x="1550" y="380" /><di:waypoint x="2090" y="380" /><di:waypoint x="2090" y="220" />
        <bpmndi:BPMNLabel><dc:Bounds x="1783" y="356" width="75" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_T_08" bpmnElement="T_08">
        <di:waypoint x="2140" y="180" /><di:waypoint x="2220" y="180" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="Edge_Msg_Request" bpmnElement="Msg_Request">
        <di:waypoint x="1010" y="220" /><di:waypoint x="1010" y="460" />
        <bpmndi:BPMNLabel><dc:Bounds x="1016" y="330" width="86" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Msg_Response" bpmnElement="Msg_Response">
        <di:waypoint x="1190" y="460" /><di:waypoint x="1190" y="220" />
        <bpmndi:BPMNLabel><dc:Bounds x="1196" y="400" width="56" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
